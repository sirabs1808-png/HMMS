<Window x:Class="StockPilot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/StockpileSystem.ico"
        Title="Stockpile System"
        Width="1440"
        Height="920"
        MinWidth="1120"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#20352F"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="17,11"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SoftButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="3,0,0,1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="10" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="S" Foreground="{DynamicResource AccentForegroundBrush}" FontSize="18"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Stockpile System" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16"
                               FontWeight="Bold" VerticalAlignment="Center" Margin="9,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="DashboardNav" Style="{StaticResource NavButtonStyle}" Tag="Dashboard"
                            Click="Navigate_Click" Background="#20352F" Foreground="{DynamicResource AccentBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0"/>
                            <TextBlock Text="Dashboard"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Tag="Products" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0"/>
                            <TextBlock Text="Inventory"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ActivityNavButton" Style="{StaticResource NavButtonStyle}" Tag="Activity" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0"/>
                            <TextBlock Text="Activity"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SuppliersNavButton" Style="{StaticResource NavButtonStyle}" Tag="Suppliers" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE902;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0"/>
                            <TextBlock Text="Suppliers"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ReportsNavButton" Style="{StaticResource NavButtonStyle}" Tag="Reports" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0"/>
                            <TextBlock Text="Reports"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="HelpNavButton" Style="{StaticResource NavButtonStyle}" Tag="Help" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0"/>
                            <TextBlock Text="Help"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AppearanceButton" Style="{StaticResource SoftButtonStyle}"
                            Click="Appearance_Click" Padding="10,8" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE771;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Appearance"/>
                        </StackPanel>
                    </Button>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="14,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="AM" Foreground="{DynamicResource AccentBrush}" FontSize="10"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Local profile" Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="Offline" Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="9" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="AppearancePanel" Grid.Row="0" Grid.RowSpan="2" Width="235"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,58,150,0"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="14" Visibility="Collapsed" Panel.ZIndex="20">
            <StackPanel>
                <TextBlock Text="ACCENT COLOR" Foreground="{DynamicResource TextMutedBrush}" FontSize="9"
                           FontWeight="Bold" Margin="1,0,0,9"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AccentVioletButton" Tag="#635BFF" Click="Accent_Click" ToolTip="Violet"
                            Width="24" Height="24" Margin="2" Background="#635BFF" BorderThickness="0" Cursor="Hand"/>
                    <Button x:Name="AccentTealButton" Tag="#087E8B" Click="Accent_Click" ToolTip="Teal"
                            Width="24" Height="24" Margin="2" Background="#087E8B" BorderThickness="0" Cursor="Hand"/>
                    <Button x:Name="AccentGreenButton" Tag="#2DDB97" Click="Accent_Click" ToolTip="Green"
                            Width="24" Height="24" Margin="2" Background="#2DDB97" BorderThickness="0" Cursor="Hand"/>
                    <Button x:Name="AccentCoralButton" Tag="#D65A31" Click="Accent_Click" ToolTip="Coral"
                            Width="24" Height="24" Margin="2" Background="#D65A31" BorderThickness="0" Cursor="Hand"/>
                    <Button x:Name="AccentRoseButton" Tag="#C0447A" Click="Accent_Click" ToolTip="Rose"
                            Width="24" Height="24" Margin="2" Background="#C0447A" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
                <TextBlock Text="CUSTOM HEX COLOR" Foreground="{DynamicResource TextMutedBrush}" FontSize="9"
                           FontWeight="Bold" Margin="1,12,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="7"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CustomAccentBox" Text="#2DDB97" Padding="7,5" FontSize="10"
                             VerticalContentAlignment="Center"/>
                    <Button x:Name="ApplyCustomAccentButton" Grid.Column="2" Content="Apply" Click="CustomAccent_Click"
                            Background="#20352F" Foreground="{DynamicResource AccentBrush}" BorderThickness="0"
                            Padding="8,4" FontSize="10" Cursor="Hand"/>
                </Grid>
                <TextBlock x:Name="AccentErrorText" Foreground="#FDA29B" FontSize="9" TextWrapping="Wrap"
                           Margin="1,5,0,0" Visibility="Collapsed"/>
                <Button x:Name="ThemeToggleButton" Content="Switch to light theme" Click="Theme_Click"
                        Foreground="{DynamicResource TextPrimaryBrush}" Background="Transparent" BorderThickness="0"
                        HorizontalContentAlignment="Left" Padding="2,10,0,0" FontSize="11" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="26,20,26,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ScreenTitle" Text="Dashboard"
                               FontSize="25" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="ScreenSubtitle" Text="Here's what's happening with your inventory today."
                               FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0"/>
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="7"
                            Padding="8,4" Margin="0,9,0,0" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="LOCAL ONLY · NOT SYNCED" Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="9" FontWeight="Bold" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="245" Height="40" Margin="0,0,12,0">
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="9"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="14" VerticalAlignment="Center" Margin="13,0,0,0"/>
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBoxStyle}"
                                 TextChanged="Search_TextChanged" BorderThickness="0" Background="Transparent"
                                 Padding="38,0,8,0" VerticalContentAlignment="Center"/>
                        <TextBlock x:Name="SearchPlaceholder" Text="Search inventory..." Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="38,0,0,0" IsHitTestVisible="False"/>
                    </Grid>
                    <Button x:Name="HeaderAddProductButton" Style="{StaticResource SoftButtonStyle}" Click="AddProduct_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0"/>
                            <TextBlock Text="Add item"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="DashboardView" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Inventory overview" FontSize="17" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="A live snapshot of stock on this computer." FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="DashboardDateText" Text="TODAY" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                        </Grid>

                        <UniformGrid Columns="4" Margin="0,0,0,16">
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Total products" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                    <TextBlock x:Name="ProductsCountText" Text="1,248" Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="25" FontWeight="Bold" Margin="0,8,0,2"/>
                                    <TextBlock Text="Across all categories" Foreground="{DynamicResource TextMutedBrush}" FontSize="9"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Units on hand" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                    <TextBlock x:Name="TotalUnitsOnHandText" Text="0" Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="25" FontWeight="Bold" Margin="0,8,0,2"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Stock value " Foreground="{DynamicResource TextMutedBrush}" FontSize="9"/>
                                        <TextBlock x:Name="StockValueText" Text="$84,320" Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="9"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Low-stock items" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                                        <TextBlock x:Name="LowStockCountText" Text="8" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="25" FontWeight="Bold"/>
                                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="7,3" Margin="10,6,0,0"
                                                VerticalAlignment="Top">
                                        <TextBlock Text="Review" Foreground="{DynamicResource WarningBrush}" FontSize="9" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="At or below reorder level" Foreground="{DynamicResource TextMutedBrush}" FontSize="9"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="Transparent"
                                    BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Stock changes" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                    <TextBlock x:Name="MovementCountText" Text="0" Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="25" FontWeight="Bold" Margin="0,8,0,2"/>
                                    <TextBlock Text="Recorded this week" Foreground="{DynamicResource TextMutedBrush}" FontSize="9"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Stock level" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="14" FontWeight="Bold"/>
                                        <TextBlock Text="Products grouped by their current quantity" Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="10" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Grid Grid.Row="1" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="166" Height="166" VerticalAlignment="Center">
                                            <Canvas x:Name="StockLevelChartCanvas" Width="160" Height="160"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    IsHitTestVisible="False">
                                                <Ellipse Canvas.Left="9" Canvas.Top="9" Width="142" Height="142"
                                                         Stroke="{DynamicResource BorderBrush}" StrokeThickness="14"/>
                                                <Path x:Name="InStockArc" Stroke="#2DDB97" StrokeThickness="14"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <Path x:Name="LowStockArc" Stroke="#F3C84B" StrokeThickness="14"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <Path x:Name="OutOfStockArc" Stroke="#F06D7A" StrokeThickness="14"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Canvas>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock x:Name="StockLevelTotalText" Text="0" Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="PRODUCTS" Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                            <Grid Margin="0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="7" Height="7" Fill="#2DDB97" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="In stock" Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="10" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="InStockCountText" Grid.Column="2" Text="0"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="Bold"/>
                                            </Grid>
                                            <Grid Margin="0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="7" Height="7" Fill="#F3C84B" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Low stock" Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="10" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="LowStockStatusCountText" Grid.Column="2" Text="0"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="Bold"/>
                                            </Grid>
                                            <Grid Margin="0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="7" Height="7" Fill="#F06D7A" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Out of stock" Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="10" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="OutOfStockCountText" Grid.Column="2" Text="0"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="Bold"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Needs attention" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="14" FontWeight="Bold"/>
                                        <TextBlock Text="Items at or below their reorder level" Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="10" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                        <ItemsControl x:Name="LowStockList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="8" Padding="9" Margin="0,5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="34"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="29" Height="29" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}"
                                                                    ClipToBounds="True">
                                                                <Grid>
                                                                    <TextBlock Text="{Binding Initials}" Foreground="{DynamicResource AccentBrush}"
                                                                               FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Image}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <Image Source="{Binding Image}" Stretch="UniformToFill">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Image}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>
                                                                </Grid>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Sku}" Foreground="{DynamicResource TextMutedBrush}"
                                                                           FontSize="9" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                                <TextBlock Text="{Binding Quantity, StringFormat={}{0} left}" Foreground="{DynamicResource WarningBrush}"
                                                                           FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                                <TextBlock Text="{Binding ReorderLevel, StringFormat={}{0} min}"
                                                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="8"
                                                                           HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="NoLowStockText" Text="No items need reordering right now."
                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                    </Grid>
                                    <Button x:Name="ViewAllProductsButton" Grid.Row="2" Content="View inventory"
                                            Style="{StaticResource SoftButtonStyle}" Click="ViewProducts_Click"
                                            HorizontalAlignment="Stretch" Padding="8,8" Margin="0,8,0,0"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Inventory activity" Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="14" FontWeight="Bold"/>
                                            <TextBlock Text="Units received and used in the last 7 days"
                                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="Received" Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="9" Margin="5,0,10,0"/>
                                            <Ellipse Width="7" Height="7" Fill="#58B8D7"/>
                                            <TextBlock Text="Used" Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="9" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,12,0,0" Height="142">
                                        <StackPanel VerticalAlignment="Top">
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                                                    Margin="0,8,0,43"/>
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                                                    Margin="0,0,0,43"/>
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"/>
                                        </StackPanel>
                                        <ItemsControl x:Name="ActivityChartItems" VerticalAlignment="Stretch">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="7"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="4,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Bottom"
                                                                    HorizontalAlignment="Center" Height="120">
                                                            <Border Width="10" Height="{Binding ReceivedHeight}"
                                                                    Background="{DynamicResource AccentBrush}"
                                                                    CornerRadius="4,4,0,0" VerticalAlignment="Bottom"/>
                                                            <Border Width="10" Height="{Binding UsedHeight}"
                                                                    Background="#58B8D7" CornerRadius="4,4,0,0"
                                                                    Margin="3,0,0,0" VerticalAlignment="Bottom"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Row="1" Text="{Binding DayLabel}"
                                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="9"
                                                                   HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="ActivityChartEmpty" Text="No stock changes in the last 7 days yet."
                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Background="{DynamicResource SurfaceBrush}" Padding="8,4"
                                                   IsHitTestVisible="False"/>
                                    </Grid>
                                    <TextBlock Grid.Row="2" Text="Chart is based on the saved stock activity ledger."
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="9" Margin="0,7,0,0"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Recent activity" Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="14" FontWeight="Bold"/>
                                            <TextBlock Text="Latest recorded stock changes" Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="10" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button Content="View all" Style="{StaticResource SoftButtonStyle}" Padding="9,6"
                                                HorizontalAlignment="Right" Click="ViewActivity_Click"/>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                        <ItemsControl x:Name="RecentMovementsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="32"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}">
                                                            <TextBlock Text="{Binding ActionIcon}" Foreground="{DynamicResource AccentBrush}"
                                                                       FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding ProductName}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       FontSize="10" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding OccurredAtLabel}" Foreground="{DynamicResource TextMutedBrush}"
                                                                       FontSize="8" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding ChangeLabel}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="NoActivityText" Text="No stock changes recorded yet."
                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="ProductsView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Product catalog" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Search and manage the items in your inventory." FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="EditProductButton" Content="Edit selected" Style="{StaticResource SoftButtonStyle}"
                                    Click="EditProduct_Click" IsEnabled="False" Margin="0,0,8,0"/>
                            <Button x:Name="RemoveProductButton" Content="Remove selected"
                                    Style="{StaticResource SoftButtonStyle}" Click="RemoveProduct_Click"
                                    IsEnabled="False" Margin="0,0,8,0" Foreground="#FFE57373"
                                    ToolTip="Remove the selected product from the catalog"/>
                            <Button x:Name="CatalogAddProductButton" Style="{StaticResource PrimaryButtonStyle}" Click="AddProduct_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0"/>
                                    <TextBlock Text="Add product"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="12">
                        <DataGrid x:Name="ProductsGrid" ItemsSource="{Binding}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" CanUserResizeRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                  Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderThickness="0" RowHeaderWidth="0" AlternatingRowBackground="{DynamicResource AppBackgroundBrush}"
                                  RowBackground="{DynamicResource SurfaceBrush}" SelectionMode="Single"
                                  CanUserSortColumns="True" FontSize="12" RowHeight="48"
                                  ColumnHeaderHeight="38" SelectionChanged="ProductsGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="PRODUCT" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="34" Height="34" CornerRadius="8"
                                                        Background="{DynamicResource AccentSoftBrush}" ClipToBounds="True">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Initials}" Foreground="{DynamicResource AccentBrush}"
                                                                   FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Image}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Image Source="{Binding Image}" Stretch="UniformToFill">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Image}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="*"/>
                                <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="*"/>
                                <DataGridTextColumn Header="IN STOCK" Binding="{Binding Quantity}" Width="*"/>
                                <DataGridTextColumn Header="REORDER AT" Binding="{Binding ReorderLevel}" Width="*"/>
                                <DataGridTextColumn Header="UNIT COST" Binding="{Binding Cost, StringFormat=C}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <Grid x:Name="ActivityView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Stock activity" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Review changes or record new stock activity with a reason."
                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button x:Name="RecordMovementButton" Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                                Click="RecordMovement_Click" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0"/>
                                <TextBlock Text="Record stock change"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="12">
                        <Grid>
                            <DataGrid x:Name="ActivityGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" CanUserResizeRows="False" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                      Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                      BorderThickness="0" RowHeaderWidth="0" AlternatingRowBackground="{DynamicResource AppBackgroundBrush}"
                                      RowBackground="{DynamicResource SurfaceBrush}" CanUserSortColumns="True"
                                      FontSize="12" RowHeight="48" ColumnHeaderHeight="38">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="WHEN" Binding="{Binding OccurredAtLabel}" Width="1.25*"/>
                                    <DataGridTextColumn Header="PRODUCT" Binding="{Binding ProductName}" Width="1.3*"/>
                                    <DataGridTextColumn Header="SKU" Binding="{Binding ProductSku}" Width="*"/>
                                    <DataGridTextColumn Header="ACTION" Binding="{Binding Action}" Width="1.1*"/>
                                    <DataGridTextColumn Header="CHANGE" Binding="{Binding ChangeLabel}" Width="*"/>
                                    <DataGridTextColumn Header="AFTER" Binding="{Binding QuantityAfter}" Width="0.7*"/>
                                    <DataGridTextColumn Header="REASON" Binding="{Binding Reason}" Width="1.5*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="No stock changes yet. Record a receipt, usage, or count adjustment to get started."
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextAlignment="Center"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding ElementName=NoActivityText, Path=Visibility}"/>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="SuppliersView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Suppliers" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Keep supplier contact details together on this computer."
                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                            <TextBlock x:Name="SupplierCountText" Text="0 suppliers"
                                       FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button x:Name="AddSupplierButton" Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                                Click="AddSupplier_Click" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0"/>
                                <TextBlock Text="Add supplier"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="12">
                        <Grid>
                            <DataGrid x:Name="SuppliersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" CanUserResizeRows="False" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                      Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                      BorderThickness="0" RowHeaderWidth="0" AlternatingRowBackground="{DynamicResource AppBackgroundBrush}"
                                      RowBackground="{DynamicResource SurfaceBrush}" CanUserSortColumns="True"
                                      FontSize="12" RowHeight="48" ColumnHeaderHeight="38">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SUPPLIER" Binding="{Binding Name}" Width="1.5*"/>
                                    <DataGridTextColumn Header="CONTACT" Binding="{Binding ContactName}" Width="1.2*"/>
                                    <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="1.6*"/>
                                    <DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="1.2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="NoSuppliersText"
                                       Text="No suppliers yet. Add one to keep its contact details handy."
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                       TextAlignment="Center" VerticalAlignment="Center"
                                       HorizontalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="Visible"/>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="ReportsView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Inventory reports" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="A snapshot of the inventory currently saved on this computer."
                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button x:Name="ExportInventoryReportButton" Grid.Column="1"
                                Content="Export inventory CSV" Style="{StaticResource SoftButtonStyle}"
                                Click="ExportInventoryReport_Click" HorizontalAlignment="Right"/>
