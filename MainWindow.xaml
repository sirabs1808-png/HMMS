                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>
