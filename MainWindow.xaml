                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Products" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                <TextBlock x:Name="ReportProductsCountText" Text="0" Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="24" FontWeight="Bold" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Stock value" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                <TextBlock x:Name="ReportStockValueText" Text="$0" Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="24" FontWeight="Bold" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Low-stock items" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                <TextBlock x:Name="ReportLowStockCountText" Text="0" Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="24" FontWeight="Bold" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Stock changes (30 days)" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                <TextBlock x:Name="ReportMovementCountText" Text="0" Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="24" FontWeight="Bold" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Stock by category" Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="Valuation uses the unit costs entered for each product."
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0"/>
                            </StackPanel>
                            <DataGrid x:Name="CategorySummaryGrid" Grid.Row="1" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" CanUserResizeRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                      Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                      BorderThickness="0" RowHeaderWidth="0"
                                      AlternatingRowBackground="{DynamicResource AppBackgroundBrush}"
                                      RowBackground="{DynamicResource SurfaceBrush}" CanUserSortColumns="True"
                                      FontSize="12" RowHeight="42" ColumnHeaderHeight="36">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="2*"/>
                                    <DataGridTextColumn Header="PRODUCTS" Binding="{Binding ProductCount}" Width="*"/>
                                    <DataGridTextColumn Header="UNITS IN STOCK" Binding="{Binding UnitsInStock}" Width="*"/>
                                    <DataGridTextColumn Header="STOCK VALUE" Binding="{Binding StockValue, StringFormat=C}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="HelpView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
