                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="20">
                            <StackPanel>
                                <TextBlock Text="COMMON QUESTIONS" Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="10" FontWeight="Bold" Margin="0,0,0,12"/>
                                <Button Tag="How do I add a product?" Click="QuickGuide_Click"
                                        Style="{StaticResource SoftButtonStyle}" HorizontalContentAlignment="Left"
                                        Margin="0,0,0,8">How do I add a product?</Button>
                                <Button Tag="How do I receive stock?" Click="QuickGuide_Click"
                                        Style="{StaticResource SoftButtonStyle}" HorizontalContentAlignment="Left"
                                        Margin="0,0,0,8">How do I receive stock?</Button>
                                <Button Tag="How do I record stock I used?" Click="QuickGuide_Click"
                                        Style="{StaticResource SoftButtonStyle}" HorizontalContentAlignment="Left"
                                        Margin="0,0,0,8">How do I record stock I used?</Button>
                                <Button Tag="How do I correct a stock count?" Click="QuickGuide_Click"
                                        Style="{StaticResource SoftButtonStyle}" HorizontalContentAlignment="Left"
                                        Margin="0,0,0,8">How do I correct a stock count?</Button>
                                <Button Tag="How do I change the colors?" Click="QuickGuide_Click"
                                        Style="{StaticResource SoftButtonStyle}" HorizontalContentAlignment="Left"
                                        Margin="0,0,0,8">How do I change the colors?</Button>
                                <Button Tag="What does low stock mean?" Click="QuickGuide_Click"
                                        Style="{StaticResource SoftButtonStyle}" HorizontalContentAlignment="Left">What does low stock mean?</Button>
                                <Button Tag="How do I add a supplier?" Click="QuickGuide_Click"
                                        Style="{StaticResource SoftButtonStyle}" HorizontalContentAlignment="Left"
                                        Margin="0,8,0,0">How do I add a supplier?</Button>
                                <Button Tag="How do I export a report?" Click="QuickGuide_Click"
                                        Style="{StaticResource SoftButtonStyle}" HorizontalContentAlignment="Left"
                                        Margin="0,8,0,0">How do I export a report?</Button>
                                <Button Tag="How do I remove a product from the catalog?" Click="QuickGuide_Click"
                                        Style="{StaticResource SoftButtonStyle}" HorizontalContentAlignment="Left"
                                        Margin="0,8,0,0">How do I remove a product?</Button>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="22">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
                                        <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource AccentBrush}" FontSize="17"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Stockpile System guide" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="13" FontWeight="Bold"/>
                                        <TextBlock Text="Built-in help · works offline" Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="10" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,24,0,18">
                                    <TextBlock x:Name="GuideQuestionText" Text="What would you like help with?"
                                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16"
                                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="GuideResponseText"
                                               Text="Choose a common question or type a task below. This offline guide uses built-in instructions; it is not the online AI assistant."
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="13"
                                               TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0"/>
                                </StackPanel>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="GuideQuestionBox" Style="{StaticResource SearchTextBoxStyle}"
                                             ToolTip="Ask how to do a task" KeyDown="GuideQuestion_KeyDown"/>
                                    <Button Grid.Column="2" Content="Ask" Style="{StaticResource PrimaryButtonStyle}"
                                            Click="AskGuide_Click"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="PlaceholderView" Visibility="Collapsed">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="40" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Width="480">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="54" Height="54" CornerRadius="16" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}"
                                           FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="PlaceholderTitle" Text="Coming soon" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                            <TextBlock Text="This screen is part of the next build phase. Your inventory data remains unchanged."
                                       TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,18"/>
                            <Button Content="Back to dashboard" Style="{StaticResource PrimaryButtonStyle}"
                                    Click="BackToDashboard_Click" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="AddProductOverlay" Grid.RowSpan="2" Background="#990E1726"
              Visibility="Collapsed" Panel.ZIndex="10">
            <Border Width="430" Padding="27" CornerRadius="16" Background="{DynamicResource SurfaceBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock x:Name="ProductFormTitle" Text="Add a product" Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="19" FontWeight="Bold"/>
                            <TextBlock x:Name="ProductFormSubtitle" Text="Add an item to your catalog." Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Click="CloseAddProduct_Click"
                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMutedBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand"/>
                    </Grid>
                    <TextBlock Text="Product name" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBox x:Name="ProductNameBox" Style="{StaticResource SearchTextBoxStyle}" Margin="0,6,0,13"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SKU" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBox x:Name="SkuBox" Style="{StaticResource SearchTextBoxStyle}" Margin="0,6,0,13"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Category" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBox x:Name="CategoryBox" Style="{StaticResource SearchTextBoxStyle}" Margin="0,6,0,13"/>
                        </StackPanel>
                    </Grid>
                    <Grid Height="72" Margin="0,0,0,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="72" Height="72" CornerRadius="10"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <TextBlock x:Name="ProductImagePlaceholder" Text="PHOTO"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="9"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="ProductImagePreview" Stretch="UniformToFill" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ChooseProductImageButton" Content="Choose photo"
                                        Style="{StaticResource SoftButtonStyle}" Click="ChooseProductImage_Click"
                                        Padding="10,7" Margin="0,0,7,0"/>
                                <Button x:Name="RemoveProductImageButton" Content="Remove"
                                        Style="{StaticResource SoftButtonStyle}" Click="RemoveProductImage_Click"
                                        Padding="10,7" IsEnabled="False"/>
                            </StackPanel>
                            <TextBlock x:Name="ProductImageStatusText" Text="No product photo"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="9"
                                       TextTrimming="CharacterEllipsis" Margin="1,7,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="QuantityLabel" Text="Opening quantity" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBox x:Name="QuantityBox" Style="{StaticResource SearchTextBoxStyle}" Text="0" Margin="0,6,0,13"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Unit cost" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBox x:Name="CostBox" Style="{StaticResource SearchTextBoxStyle}" Text="0.00" Margin="0,6,0,13"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Reorder level" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBox x:Name="ReorderLevelBox" Style="{StaticResource SearchTextBoxStyle}" Text="5" Margin="0,6,0,13"/>
                        </StackPanel>
                        <TextBlock x:Name="ProductFormHint" Grid.Column="2"
                                   Text="To change on-hand stock, use Stock activity so the change is recorded."
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Margin="0,0,0,13" Visibility="Collapsed"/>
                    </Grid>
                    <TextBlock x:Name="FormErrorText" Foreground="#D04444" FontSize="11" TextWrapping="Wrap"
                               Margin="0,0,0,10" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SoftButtonStyle}" Click="CloseAddProduct_Click" Margin="0,0,8,0"/>
                        <Button x:Name="SaveProductButton" Content="Save product" Style="{StaticResource PrimaryButtonStyle}" Click="SaveProduct_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="StockMovementOverlay" Grid.RowSpan="2" Background="#990E1726"
              Visibility="Collapsed" Panel.ZIndex="11">
            <Border Width="470" Padding="27" CornerRadius="16" Background="{DynamicResource SurfaceBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Record stock change" Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="19" FontWeight="Bold"/>
                            <TextBlock Text="Every change is saved with its reason and time."
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Click="CloseMovement_Click"
                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMutedBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand"/>
                    </Grid>
                    <TextBlock Text="Product" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                    <ComboBox x:Name="MovementProductCombo" Padding="9,7" Margin="0,6,0,13"
                              Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Type of change" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                    <ComboBox x:Name="MovementTypeCombo" Padding="9,7" Margin="0,6,0,13"
                              SelectionChanged="MovementType_SelectionChanged"
                              Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
                        <ComboBoxItem Content="Receive stock"/>
                        <ComboBoxItem Content="Use or remove stock"/>
                        <ComboBoxItem Content="Set counted stock level"/>
                    </ComboBox>
                    <TextBlock x:Name="MovementQuantityLabel" Text="Quantity to receive"
                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBox x:Name="MovementQuantityBox" Style="{StaticResource SearchTextBoxStyle}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="MovementQuantityHelpText" Text="Enter a whole number greater than zero."
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="1,5,0,13"/>
                    <TextBlock Text="Reason" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBox x:Name="MovementReasonBox" Style="{StaticResource SearchTextBoxStyle}"
                             Margin="0,6,0,13" ToolTip="For example: purchase order, sale, damaged, or cycle count"/>
                    <TextBlock x:Name="MovementFormErrorText" Foreground="#D04444" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SoftButtonStyle}"
                                Click="CloseMovement_Click" Margin="0,0,8,0"/>
                        <Button x:Name="SaveMovementButton" Content="Save stock change"
                                Style="{StaticResource PrimaryButtonStyle}" Click="SaveMovement_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="AddSupplierOverlay" Grid.RowSpan="2" Background="#990E1726"
              Visibility="Collapsed" Panel.ZIndex="12">
            <Border Width="450" Padding="27" CornerRadius="16" Background="{DynamicResource SurfaceBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Add supplier" Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="19" FontWeight="Bold"/>
                            <TextBlock Text="Supplier details are saved on this computer."
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Click="CloseSupplier_Click"
                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMutedBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand"/>
                    </Grid>
                    <TextBlock Text="Supplier name" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBox x:Name="SupplierNameBox" Style="{StaticResource SearchTextBoxStyle}" Margin="0,6,0,13"/>
                    <TextBlock Text="Contact person (optional)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBox x:Name="SupplierContactBox" Style="{StaticResource SearchTextBoxStyle}" Margin="0,6,0,13"/>
                    <TextBlock Text="Email (optional)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBox x:Name="SupplierEmailBox" Style="{StaticResource SearchTextBoxStyle}" Margin="0,6,0,13"/>
                    <TextBlock Text="Phone (optional)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBox x:Name="SupplierPhoneBox" Style="{StaticResource SearchTextBoxStyle}" Margin="0,6,0,13"/>
                    <TextBlock x:Name="SupplierFormErrorText" Foreground="#D04444" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SupplierCancelButton" Content="Cancel" Style="{StaticResource SoftButtonStyle}"
                                Click="CloseSupplier_Click" Margin="0,0,8,0"/>
                        <Button x:Name="SaveSupplierButton" Content="Save supplier"
                                Style="{StaticResource PrimaryButtonStyle}" Click="SaveSupplier_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
